FROM flink:1.19.3

# Installer Python 3 et pip
RUN apt-get update -y && \
    apt-get install -y python3 python3-pip python3-dev wget && \
    rm -rf /var/lib/apt/lists/*

# Lien symbolique "python" -> "python3" (Flink appelle "python" par défaut)
RUN ln -s /usr/bin/python3 /usr/bin/python

# Installer PyFlink aligné sur Flink 1.19.3
RUN pip3 install apache-flink==1.19.3

# Télécharger le connecteur Kafka dans /opt/flink/lib
RUN wget -P /opt/flink/lib \
    https://repo1.maven.org/maven2/org/apache/flink/flink-sql-connector-kafka/3.2.0-1.19/flink-sql-connector-kafka-3.2.0-1.19.jar